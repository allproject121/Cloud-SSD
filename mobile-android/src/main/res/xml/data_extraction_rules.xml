<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes into cloud backups or a device-to-device copy: the pairing key and Google sign-ins stay
     on this phone (they could not be read elsewhere anyway; the key store does not move). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
