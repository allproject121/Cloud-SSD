<UserControl x:Class="CloudSSD.Desktop.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CloudSSD.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <!-- Advice -->
            <ItemsControl ItemsSource="{Binding Advice}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" BorderBrush="{Binding Tone, Converter={StaticResource Tone}}">
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Auto mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run now" Command="{Binding RunReliefCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <CheckBox Content="Auto mode: when less than 30% of RAM is free, move idle background apps out of RAM" IsChecked="{Binding AutoRelief}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ReliefStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{Binding ReliefTone, Converter={StaticResource Tone}}" />
                    <TextBlock Text="Nothing is closed and nothing is lost. A moved app is a little slow the next time you open it. Apps you used in the last 15 minutes, a running game, Windows and Cloud-SSD are left alone." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Game mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Game mode: when a game or a phone stream starts, free RAM at once and close the apps chosen here" IsChecked="{Binding GameModeOn}" />
                    <CheckBox Content="Open those apps again when the game is over" IsChecked="{Binding ReopenAfterGame}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding GameModeStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}" />
                    <ItemsControl ItemsSource="{Binding CloseForGame}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,4,4,4" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Content="✕" Padding="6,1" Margin="8,0,0,0" ToolTip="{Binding}"
                                                Command="{Binding DataContext.RemoveFromGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Game mode acts for a game started from the Game Library and for an Android emulator in front (BlueStacks and the like). Each app is asked to close the normal way, so one with unsaved work stays open and asks you." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI row -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RAM IN USE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding RamInUse}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Metric}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RamTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Caption}" />
                        <ProgressBar Value="{Binding RamFraction}" Maximum="1" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RAM FREE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding RamFree}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RESERVED BY APPS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Commit}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Metric}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommitTone}" Value="error">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CommitDetail}" Style="{StaticResource Caption}" />
                        <ProgressBar Value="{Binding CommitFraction}" Maximum="1" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PAGE FILE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding PageFileSize}" Style="{StaticResource Metric}" />
                        <TextBlock Text="{Binding PageFileUse}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding RamNow}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            <TextBlock Text="RAM use (last 5 min)" Style="{StaticResource H2}" />
                        </DockPanel>
                        <c:Sparkline Values="{Binding RamHistoryValues}" Height="170" Stroke="{StaticResource Accent}" Capacity="300" MaxValue="1" Format="{Binding PercentFormat}" />
                        <TextBlock Text="Near the top, Windows starts using the page file on the SSD and games stutter." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Page file" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding PageFile}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3"><TextBlock Text="{Binding Key}" Width="80" Foreground="{StaticResource Dim}" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{Binding Tone, Converter={StaticResource Tone}}" /></DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Open Windows page-file settings" Command="{Binding OpenPageFileSettingsCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" />
                        <TextBlock Text="Best setting: 'Automatically manage paging file size for all drives'. A page file stops crashes when RAM is full; it does not make the PC faster." Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Apps using the most RAM" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{Binding DataContext.CloseInGamesLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" HorizontalAlignment="Right" Margin="16,0,0,0" Padding="10,4"
                                            Command="{Binding DataContext.ChooseForGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanChoose, Converter={StaticResource Vis}}" />
                                    <Button Grid.Column="3" Content="{Binding DataContext.CloseLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" HorizontalAlignment="Right" MinWidth="76" Margin="0" Padding="10,4"
                                            Command="{Binding DataContext.CloseAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanClose, Converter={StaticResource Vis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="RAM held by all of an app's processes together (approximate). Close asks the app to close the normal way, like pressing X. Apps without a window of their own have no Close button." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Caption}" Margin="2,0,14,0"
                       Text="This page only reads what Windows reports. It never changes a Windows setting and closes an app only when you press Close." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
