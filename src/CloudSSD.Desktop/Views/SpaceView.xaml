<UserControl x:Class="CloudSSD.Desktop.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One line with a size bar and a ⋮ menu: used for slices, folders, files, apps, RAM and clean-ups. -->
        <DataTemplate x:Key="RowTemplate">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="8" Background="{StaticResource Surface2}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Hyperlink Command="{Binding Open}" TextDecorations="None">
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="3" Content="⋮" Padding="10,2" Margin="10,0,0,0" FontSize="15" Click="More_Click"
                            Visibility="{Binding HasMenu, Converter={StaticResource Vis}}" ToolTip="What can be done">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Menu}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Header}" />
                                        <Setter Property="Command" Value="{Binding Command}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <!-- Devices -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Read again" Command="{Binding RescanCommand}" Padding="12,5" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Margin="0,0,8,0" Padding="14,5"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedDevice.Name}" Style="{StaticResource H2}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" Foreground="{Binding DeviceTone, Converter={StaticResource Tone}}" />
                </StackPanel>
            </Border>

            <!-- KPI row -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STORAGE USED" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Metric}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STORAGE FREE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Metric}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource Metric}" FontSize="20" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tabs -->
            <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="4" Margin="0,0,0,14">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="TabOverview" Content="Overview" IsChecked="True" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabFolders" Content="Folders" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabApps" Content="Apps" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabRam" Content="RAM" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabClean" Content="Clean up" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabStartup" Content="Startup" Style="{StaticResource PillRadio}" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Visibility="{Binding IsPc, Converter={StaticResource Vis}}" />
                </UniformGrid>
            </Border>

            <!-- Overview -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabOverview, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Disks" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What takes the space" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="Tap a name to see what is inside. The ⋮ button says how much an action frees before it is done." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Folders -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabFolders, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="↑ Up" Command="{Binding FolderUpCommand}" Padding="10,4" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,6,0">
                                        <Hyperlink Command="{Binding Open}"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                        <Run Text=" ›" Foreground="{StaticResource Dim}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <TextBlock Text="{Binding FolderNote}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding FolderItems}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Apps -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabApps, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Installed apps, biggest first" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource RowTemplate}" />
                    <TextBlock Text="Sizes are what each installer reported. Uninstall opens the program's own uninstaller, where you finish it." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- RAM -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabRam, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Where the RAM is" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding RamGroups}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Apps using RAM" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding RamApps}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="Close asks the app to close the normal way, so it can still ask to save. End task stops it at once." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Clean up -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabClean, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Clean in one go" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Cleanups}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Largest files" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding LargeFiles}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsPc, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Search again" Command="{Binding FindDuplicatesCommand}" Padding="10,4" />
                            <TextBlock Text="Files that exist twice" Style="{StaticResource H2}" />
                        </DockPanel>
                        <TextBlock Text="{Binding DuplicatesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Duplicates}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Startup -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabStartup, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Apps that start with Windows" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Startup}" ItemTemplate="{StaticResource RowTemplate}" />
                    <TextBlock Text="Switching one off is the same as in Task Manager: it stays installed and can be switched on again." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="2,0,14,0" TextWrapping="Wrap"
                       Text="Windows' own folders, programs' folders and Cloud-SSD's data are never offered for deleting. Nothing is removed without you choosing it." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
