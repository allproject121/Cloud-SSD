<UserControl x:Class="CloudSSD.Desktop.Views.SmartCacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <!-- Smart Storage Saver & Auto Cloud Offload Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{StaticResource Accent}" BorderThickness="1.5">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="⚡ Move Files to Cloud Drive Now" Style="{StaticResource Primary}"
                                    Command="{Binding OffloadNowCommand}" Padding="14,6" Margin="0,0,8,0" />
                            <Button Content="Save Settings" Command="{Binding SaveOffloadSettingsCommand}" Padding="12,6" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="⚡ SMART SPACE SAVER &amp; AUTO CLOUD OFFLOAD" Style="{StaticResource H2}" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="When laptop storage drops below your limit, local files automatically switch to Cloud Drive (Z:)." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Status Banner -->
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{Binding OffloadStatusTone, Converter={StaticResource Tone}}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding OffloadStatusText}" FontWeight="Bold" FontSize="13" Foreground="{Binding OffloadStatusTone, Converter={StaticResource Tone}}" />
                                <TextBlock Text="{Binding LaptopDiskSummary}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                <ProgressBar Height="6" Maximum="100" Value="{Binding LaptopDiskPercent}" Margin="0,6,0,0" Foreground="{StaticResource Accent}" Background="{StaticResource Bg}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="{Binding TargetDriveDisplayName}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource Purple}" />
                                <TextBlock Text="{Binding UploadsPendingSummary}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Controls Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox IsChecked="{Binding AutoOffloadEnabled}" Content="Enable Auto Cloud Switch on Low Storage"
                                  VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Trigger when laptop free space is below:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Dim}" />
                            <TextBox Text="{Binding OffloadThresholdGb, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                            
                            <ItemsControl ItemsSource="{Binding OffloadPresets}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat={}{0} GB}" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.PresetOffloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <CheckBox IsChecked="{Binding CleanTempFiles}" Margin="0,10,0,0" FontSize="13"
                              Content="First delete old temporary files (untouched for 7 days, not in use)" />
                    <CheckBox IsChecked="{Binding OffloadDownloads}" Margin="0,6,0,0" FontSize="13"
                              Content="Also move old big files from Downloads (over 100 MB, untouched for 7 days; folders are never moved). A shortcut stays in Downloads." />
                    <CheckBox IsChecked="{Binding CleanRecycleBin}" Margin="0,6,0,0" FontSize="13"
                              Content="Also empty Recycle Bin items deleted more than 30 days ago" />
                    <TextBlock Text="While a game or a phone stream is running, nothing new is cleaned or moved and cloud uploads run slowly." Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

                    <!-- Files moved from Downloads, with a way back -->
                    <DockPanel Margin="0,14,0,4">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshMovedCommand}" Padding="10,4" />
                        <TextBlock Text="FILES MOVED FROM DOWNLOADS TO THE CLOUD" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding MovedFilesSummary}" FontSize="12" Foreground="{StaticResource Muted}" />
                    <ItemsControl ItemsSource="{Binding MovedFiles}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.BringBackLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Padding="10,4" Margin="10,0,0,0"
                                            Command="{Binding DataContext.BringBackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- What is using the space -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Scan now" Style="{StaticResource Primary}" Command="{Binding ScanSpaceCommand}" Padding="14,6" />
                        <StackPanel>
                            <TextBlock Text="What is using the space" Style="{StaticResource H2}" />
                            <TextBlock Text="Shows the biggest folders and files on the Windows drive, so you can see what to delete or move. Nothing is changed." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding SpaceScanStatus}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SpaceRows}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Size}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding DataContext.OpenLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenSpaceFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Storage budget" Style="{StaticResource H2}" />
                        <TextBlock Text="CACHE BUDGET (GB, all drives)" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding BudgetGb, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <ItemsControl ItemsSource="{Binding Presets}" Margin="10,0,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat={}{0} GB}" Padding="10,5" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="PROTECTED FREE SPACE FOR WINDOWS (GB)" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding ReserveGb, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Text="EVICT DATA NOT USED FOR (DAYS)" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Text="CACHE LOCATION" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseLocationCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding CacheRoot, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding VolumeInfo}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Primary}" Content="Apply" Command="{Binding ApplyCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Content="Clear temporary files of disconnected drives…" Style="{StaticResource DangerButton}" Command="{Binding ClearCacheCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Usage" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Usage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3"><TextBlock Text="{Binding Key}" Width="200" Foreground="{StaticResource Dim}" /><TextBlock Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontWeight="SemiBold" /></DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Effective}" Foreground="{StaticResource Accent}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Eviction and safety" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Eviction is done by rclone: least-recently-used files are removed when the budget or the protected free space is exceeded, and data unused for the maximum age expires. Only cached copies are ever removed — never cloud originals, never files outside the Cloud Drive cache folder, never save games." />
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Pin selected file" Command="{Binding PinCommand}" />
                            <Button Content="Touch pinned files now" Command="{Binding WarmPinnedCommand}" />
                        </StackPanel>
                        <TextBlock Text="Pinned files (kept most-recently-used)" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="No pinned files." Style="{StaticResource Caption}" Visibility="{Binding Pinned.Count, Converter={StaticResource NotVis}}" />
                    <ItemsControl ItemsSource="{Binding Pinned}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Unpin" Style="{StaticResource Ghost}" Padding="6,2"
                                            Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Cached files (most recently used first)" Style="{StaticResource H2}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DRIVE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="FILE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="DOWNLOADED" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="3" Text="ON DISK" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="4" Text="LOGICAL" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="5" Text="LAST ACCESS" Style="{StaticResource Label}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0" MaxHeight="420"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Padding" Value="0,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mount}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Cached}" FontSize="12" />
                                        <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="3" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Physical}" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding Logical}" FontSize="12" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="5" Text="{Binding LastAccess}" FontSize="12" Foreground="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
