<Window x:Class="CloudSSD.Desktop.Views.GameSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game settings" Width="680" Height="740" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,10,0,4" />
            <TextBox x:Name="NameBox" Margin="0,0,0,12" />

            <TextBlock Text="EXECUTABLE (relative to the game folder)" Style="{StaticResource Label}" />
            <ComboBox x:Name="ExeBox" IsEditable="False" Margin="0,0,0,4" />
            <TextBlock x:Name="ExeHint" Style="{StaticResource Caption}" Margin="0,0,0,12" />

            <TextBlock Text="COMMAND-LINE ARGUMENTS" Style="{StaticResource Label}" />
            <TextBox x:Name="ArgsBox" Margin="0,0,0,12" />

            <TextBlock Text="WORKING DIRECTORY (relative; empty = executable's folder)" Style="{StaticResource Label}" />
            <TextBox x:Name="WorkBox" Margin="0,0,0,14" />

            <TextBlock Text="EXECUTION MODE" Style="{StaticResource Label}" />
            <RadioButton x:Name="ModeCloud" GroupName="mode">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}"><Run Text="Cloud Direct" FontWeight="SemiBold" /><Run Text=" — launch straight from the virtual drive; everything streams through the cache." Foreground="{StaticResource Muted}" /></TextBlock>
            </RadioButton>
            <RadioButton x:Name="ModeHybrid" GroupName="mode">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}"><Run Text="Hybrid Optimized" FontWeight="SemiBold" /><Run Text=" — executables, DLLs, configs and small files copied to the SSD; large assets streamed via symbolic links. Game writes stay local." Foreground="{StaticResource Muted}" /></TextBlock>
            </RadioButton>
            <RadioButton x:Name="ModeLocal" GroupName="mode">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}"><Run Text="Full Local" FontWeight="SemiBold" /><Run Text=" — run a complete local copy (use 'Install locally…' first; requires your approval)." Foreground="{StaticResource Muted}" /></TextBlock>
            </RadioButton>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Caption}" Margin="0,4,0,14" />

            <!-- Cloud Save Game Backup Section -->
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource Surface2}" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="CLOUD SAVE-GAME BACKUP &amp; SYNC" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Purple}" Margin="0,0,0,8" />
                    <CheckBox x:Name="CloudSaveBox" Content="Automatically back up save games to cloud when game exits" IsChecked="True" Margin="0,0,0,8" />

                    <TextBlock Text="SAVE FOLDER LOCATION" Style="{StaticResource Label}" Margin="0,4,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SavePathBox" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Auto-Detect" Click="AutoDetectSave" Margin="0,0,6,0" Style="{StaticResource Ghost}" />
                        <Button Grid.Column="2" Content="Browse…" Click="BrowseSavePath" Margin="0" Style="{StaticResource Ghost}" />
                    </Grid>
                    <TextBlock x:Name="SavePathHint" Style="{StaticResource Caption}" Margin="0,0,0,8" Foreground="{StaticResource Dim}" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BackupNowBtn" Content="Backup Saves Now" Click="BackupSavesNow" Margin="0,0,10,0" Style="{StaticResource Primary}" />
                        <Button x:Name="RestoreBtn" Content="Restore from Cloud" Click="RestoreSavesNow" Margin="0,0,10,0" />
                    </StackPanel>
                    <TextBlock x:Name="SaveStatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{StaticResource Success}" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="AwareBox" Content="Game-Aware Mode: accept world-position telemetry from an authorized game plugin" />
            <TextBlock x:Name="AwareHint" Style="{StaticResource Caption}" Margin="26,2,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource Primary}" Content="Save" Click="Ok" />
                <Button Content="Cancel" IsCancel="True" Margin="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
